# Plantilla de variables de entorno — copiar a .env y rellenar:
#   Copy-Item .env.example .env
# El .env real NUNCA se sube a Git.

DB_NAME=sigpa_ga
DB_USER=postgres
DB_PASSWORD=cambiar_por_password_fuerte
DB_HOST=127.0.0.1
DB_PORT=5432

# Clave secreta de Django. Generar una nueva por proyecto/clon con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Si la clave contiene el carácter $, guardarla entre comillas simples (SECRET_KEY='...'),
# para que Docker Compose no intente expandirla.
SECRET_KEY=

# Configuración de la aplicación
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Superusuario inicial del panel admin.
# Se crea con: python manage.py crear_superusuario (tras migrar; idempotente).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_por_password_fuerte

# Autenticación JWT (Semana 2) — decisiones en docs/decisiones_seguridad.md
# Duración del token de acceso (minutos) y del token de renovación (días).
JWT_ACCESS_MINUTOS=15
JWT_REFRESCO_DIAS=7
# Marcar True solo detrás de HTTPS en producción (cookies Secure).
JWT_COOKIE_SECURE=False

# Rate limit del login: límite por IP, intentos fallidos por cuenta
# y minutos de bloqueo automático.
LOGIN_RATE_IP=30/min
LOGIN_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Listados de la API (Semana 3): páginas de 20 por defecto.
API_PAGE_SIZE=20

# Respaldo de la base de datos (Semana 19) — FUERA del repositorio.
# El contenedor Docker de PostgreSQL para pg_dump/psql.
RESPALDO_DIR=
RESPALDO_KEEP=10
DB_DOCKER_CONTAINER=sigpa_db

# Importación histórica (Semana 20) — FUERA del repositorio.
IMPORTACION_DIR=

# Dataset de Machine Learning (Semana 21) — FUERA del repositorio y de
# carpetas sincronizadas en la nube (D:\DatasetSigpa, no un subdirectorio
# de Git): ahí escribe el comando `exportar_dataset` su CSV y su ficha.
ML_EXPORT_DIR=

